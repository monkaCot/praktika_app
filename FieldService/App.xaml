<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FieldService"
             x:Class="FieldService.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InputBorder" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource Gray200}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="6,0" />
            </Style>

            <Style x:Key="FieldCaption" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource Gray500}" />
                <Setter Property="Margin" Value="2,8,0,2" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource Gray200}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="12,6" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
