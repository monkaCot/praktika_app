<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FieldService.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FieldService"
    Title="FieldService"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White">

    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate local:LoginPage}"
        FlyoutItemIsVisible="False"
        Shell.FlyoutBehavior="Disabled"
        Shell.NavBarIsVisible="False" />

    <FlyoutItem x:Name="TabRequests" Title="Заявки" Route="main">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="TabUsers" Title="Пользователи">
        <ShellContent ContentTemplate="{DataTemplate local:UsersPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="TabProfile" Title="Профиль">
        <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" />
    </FlyoutItem>

</Shell>