<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FieldService.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FieldService"
    Shell.FlyoutBehavior="Flyout"
    Title="FieldService">

    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Shell.NavBarIsVisible="False" />

    <TabBar Route="main">
        <ShellContent x:Name="TabRequests"
                      Title="Заявки"
                      ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent x:Name="TabUsers"
                      Title="Пользователи"
                      ContentTemplate="{DataTemplate local:UsersPage}" />
        <ShellContent x:Name="TabProfile"
                      Title="Профиль"
                      ContentTemplate="{DataTemplate local:ProfilePage}" />
    </TabBar>

</Shell>