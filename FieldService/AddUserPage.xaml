<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldService.ViewModels"
             xmlns:controls="clr-namespace:FieldService.Controls"
             x:Class="FieldService.AddUserPage"
             x:DataType="vm:AddUserViewModel"
             BackgroundColor="White"
             Title="Новый пользователь">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="4">

                <Label Text="Имя" Style="{StaticResource FieldCaption}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding FullName}" Placeholder="Имя" />
                </Border>

                <Label Text="Логин" Style="{StaticResource FieldCaption}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding Username}" Placeholder="Логин" />
                </Border>

                <Label Text="Пароль" Style="{StaticResource FieldCaption}" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Text="{Binding Password}" Placeholder="Пароль" IsPassword="True" />
                </Border>

                <Label Text="Роль" Style="{StaticResource FieldCaption}" />
                <Border Style="{StaticResource InputBorder}">
                    <Picker ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole}" />
                </Border>

                <Label Text="{Binding Message}" TextColor="#DC2626" Margin="0,8,0,0" />

                <Button Text="Создать"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <controls:BrandFooter Grid.Row="1" />
    </Grid>
</ContentPage>