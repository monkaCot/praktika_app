<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldService.ViewModels"
             x:Class="FieldService.AddUserPage"
             x:DataType="vm:AddUserViewModel"
             Title="Новый пользователь">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Entry Text="{Binding FullName}" Placeholder="Имя" />
            <Entry Text="{Binding Username}" Placeholder="Логин" />
            <Entry Text="{Binding Password}" Placeholder="Пароль" IsPassword="True" />

            <Label Text="Роль" />
            <Picker ItemsSource="{Binding AvailableRoles}"
                    SelectedItem="{Binding SelectedRole}" />

            <Label Text="{Binding Message}" TextColor="Red" />

            <Button Text="Создать" Command="{Binding SaveCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>