<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldService.ViewModels"
             x:Class="FieldService.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Профиль">

    <VerticalStackLayout Padding="25" Spacing="14">
        <Label Text="{Binding FullName}" FontSize="24" FontAttributes="Bold" />
        <Label Text="{Binding Username, StringFormat='Логин: {0}'}" />
        <Label Text="{Binding Role, StringFormat='Роль: {0}'}" />
        <Button Text="Выйти" Command="{Binding LogoutCommand}" Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>