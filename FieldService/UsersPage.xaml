<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldService.ViewModels"
             xmlns:models="clr-namespace:FieldService.Models"
             x:Class="FieldService.UsersPage"
             x:DataType="vm:UsersViewModel"
             Title="Пользователи">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Command="{Binding GoToAddUserCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Users}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:User">
                <Border Margin="10,5" Padding="12" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="17" />
                        <Label Text="{Binding Username, StringFormat='Логин: {0}'}" FontSize="13" />
                        <Label Text="{Binding Role, StringFormat='Роль: {0}'}" FontSize="13" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>