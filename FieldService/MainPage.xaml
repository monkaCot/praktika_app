<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldService.ViewModels"
             xmlns:models="clr-namespace:FieldService.Models"
             x:Class="FieldService.MainPage"
             x:DataType="vm:RequestsViewModel"
             Title="Заявки">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="AddButton" Text="+" Command="{Binding GoToAddCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Requests}">

        <CollectionView.EmptyView>
            <Label Text="Заявок пока нет"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:ServiceRequest">
                <Border Margin="10,5" Padding="12"
                        StrokeShape="RoundRectangle 10">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{Binding ClientName}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Address}" FontSize="14" />
                            <Label Text="{Binding Problem}" FontSize="13" TextColor="Gray" />
                            <Label Text="{Binding Status}" FontSize="12" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="📄"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.GenerateDocumentCommand}"
                                CommandParameter="{Binding .}"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>