<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldService.ViewModels"
             x:Class="FieldService.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Вход">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="18" VerticalOptions="Center">

            <Label Text="Вход в систему"
                   FontSize="28" FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Entry Text="{Binding Username}" Placeholder="Логин" />
            <Entry Text="{Binding Password}" Placeholder="Пароль" IsPassword="True" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Button Text="Войти" Command="{Binding LoginCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>