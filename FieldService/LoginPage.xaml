<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldService.ViewModels"
             xmlns:controls="clr-namespace:FieldService.Controls"
             x:Class="FieldService.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource White}"
             Title="Вход">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="28" Spacing="16" VerticalOptions="Center">

                <Image Source="logo.jpg" HeightRequest="120" Margin="0,10,0,0" />

                <Label Text="Сервис-центр «Админ»"
                       FontSize="22" FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />

                <Label Text="Вход в систему"
                       FontSize="15" HorizontalOptions="Center"
                       TextColor="{StaticResource Gray500}"
                       Margin="0,0,0,12" />

                <Border Stroke="{StaticResource Gray200}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="6,0">
                    <Entry Text="{Binding Username}" Placeholder="Логин" />
                </Border>

                <Border Stroke="{StaticResource Gray200}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="6,0">
                    <Entry Text="{Binding Password}" Placeholder="Пароль" IsPassword="True" />
                </Border>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="#DC2626" HorizontalOptions="Center" />

                <Button Text="Войти"
                        Command="{Binding LoginCommand}"
                        CornerRadius="12" HeightRequest="48" />

                <Button Text="Регистрация"
                        Command="{Binding GoToRegisterCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}" />

            </VerticalStackLayout>
        </ScrollView>

        <controls:BrandFooter Grid.Row="1" />

    </Grid>
</ContentPage>